    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#3D3A35"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FDFBF7"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
