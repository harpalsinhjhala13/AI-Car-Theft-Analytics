{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "TheftAnalyticsLight-92ea6090.json",
  "dataColors": [
    "#24385F",
    "#0E9384",
    "#2F6FDE",
    "#7A5AF8",
    "#B54708",
    "#C11574",
    "#0B7285",
    "#5925DC",
    "#027A48",
    "#D62839",
    "#475467",
    "#9E6B00",
    "#3E4784"
  ],
  "good": "#12B76A",
  "neutral": "#F59E0B",
